{
	"name": "fluxbeats",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:full": "bun run build && bunx wrangler pages dev dist/ --ip localhost --port 4321",
		"build": "tsc -b && vite build",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"preview": "vite preview",
		"test": "vitest",
		"test:unit": "vitest run",
		"test:ui": "vitest --ui",
		"test:smoke": "bun run build && playwright test -c playwright.smoke.config.ts",
		"test:e2e": "bun run build && playwright test -c playwright.config.ts",
		"snyk:auth": "snyk auth",
		"snyk:test": "snyk test",
		"snyk:monitor": "snyk monitor"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.9.1",
		"@marsidev/react-turnstile": "^1.6.1",
		"@tailwindcss/vite": "^4.3.3",
		"hono": "^4.13.5",
		"lucide-react": "^1.40.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router-dom": "^7.18.3",
		"react-use-audio-player": "^4.0.2",
		"resend": "^6.26.0",
		"tailwindcss": "^4.3.3",
		"zod": "^4.5.4",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@cloudflare/workers-types": "^5.20260903.1",
		"@playwright/test": "^1.62.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"jsdom": "^30.0.1",
		"snyk": "^1.1307.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^5.0.0",
		"wrangler": "^4.129.0"
	}
}
