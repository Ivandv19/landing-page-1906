# Build (Vite) — se pasan en build-time
# Cloudflare Turnstile Site Key (pública, del lado cliente)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# Server (Wrangler) — van en .dev.vars para local / Dashboard para prod
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=fluxbeats@mgdc.site
CONTACT_EMAIL=destino@ejemplo.com
TURNSTILE_SECRET_KEY=0x4AAAAAAA...
