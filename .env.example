# Build (Vite) — variables públicas del cliente
# Para desarrollo/testing local usa la clave de prueba oficial (1x00000000000000000000AA = Always Passes)
# Para producción se configura la clave real generada en Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server (Wrangler) — variables en .dev.vars para local / Cloudflare Secrets para producción
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=fluxbeats@mgdc.site
CONTACT_EMAIL=destino@ejemplo.com
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
